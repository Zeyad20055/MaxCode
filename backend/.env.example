# Backend
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/max_code_academy?retryWrites=true&w=majority
JWT_ACCESS_SECRET=CHANGE_THIS_DEVELOPMENT_SECRET_BEFORE_DEPLOYMENT_32_CHARS_MIN
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Initial Super Admin (created once; never overwrite an existing account)
SUPER_ADMIN_NAME=MAX CODE Owner
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPasswordBeforeProduction!
